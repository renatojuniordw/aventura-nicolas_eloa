{
  "name": "aventura-nicolas_eloa",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Aventura do Nicolas&Eloá — jogo de plataforma 2D educativo, motor em TypeScript com Canvas 2D e UI em React.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate:levels": "node --import ./tools/register-ts-hook.mjs tools/generate-levels.mts",
    "generate:embeddings": "node --import ./tools/register-ts-hook.mjs tools/generate-embeddings.mts",
    "generate:pwa-icons": "node tools/generate-pwa-icons.mjs",
    "replay:session": "node --import ./tools/register-ts-hook.mjs tools/replay-session.mts",
    "export:obsidian": "node tools/export-obsidian.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@xenova/transformers": "^2.17.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.3"
  }
}
